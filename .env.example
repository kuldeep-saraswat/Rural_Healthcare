# RuralCare AI - optional configuration
#
# Everything below is OPTIONAL. With no .env file at all the app runs fully
# offline on its deterministic on-device intent router and fictional demo data.
# Never put an API key in these variables: VITE_ vars are bundled into the
# client. Point VITE_AI_ROUTER_URL at your own backend, and keep the model
# credential on that backend.

# Endpoint for a hosted intent classifier.
# Contract: POST { text, language } -> { intent, entities? }
# On timeout, error or unknown intent the app silently falls back to the
# on-device router, so patient safety never depends on the network.
# VITE_AI_ROUTER_URL=https://your-backend.example.com/api/intent

# How long to wait for that endpoint before falling back (milliseconds).
# VITE_AI_ROUTER_TIMEOUT_MS=2500
